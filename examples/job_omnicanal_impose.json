              "nom": "nom_client",
              "email": "mail",
              "telephone": "tel"
            }
          }
        ],
        "matchColumns": [
          "email",
          "telephone"
        ],
        "sourcePriority": [
          "web",
          "boutique"
        ],
        "justification": "un client present sur les deux canaux ne doit compter qu'une fois"
      },
      {
